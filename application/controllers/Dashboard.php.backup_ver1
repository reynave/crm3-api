                "start_datetime" => $row->start_date . ' ' . $row->start_time,
            );
            array_push($event, $temp);
        }

        $visit = [];
        $query = $this->db->query('SELECT * FROM crm3_activity WHERE input_date  > CURDATE() - INTERVAL 1 MONTH AND   presence = 1 AND closed = 0 AND id_activity_type = 200 ' . $q_user);
        foreach ($query->result() as $row) {
            $temp = array(
                "id" => $row->id,
