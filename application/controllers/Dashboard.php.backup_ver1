<?php
defined('BASEPATH') or exit('No direct script access allowed');

class Dashboard extends CI_Controller
{
    public function __construct()
    {
        parent::__construct();
        $this->key = $this->db->key;
        $this->openAPI = $this->db->openAPI;
        header('Access-Control-Allow-Origin: *');
        //header("Access-Control-Allow-Headers: Origin, X-Requested-With, Content-Type, Accept");
        header("Access-Control-Allow-Headers: Key, Token,  Content-Type");

        header('Access-Control-Allow-Methods: GET, POST, PUT');
        header('Content-Type: application/javascript');
        // error_reporting(E_ALL);
        date_default_timezone_set('Asia/Jakarta');
        $this->db->query("SET time_zone = '+07:00'");
        //  $this->core->https();

        if (!$this->model->header($this->openAPI)) {
            echo $this->model->error("Error auth");
            exit;
        }
    }

    public function index()
    {
        $id = $this->input->get('id');

        $peroid = $this->input->get('period');
        $interval = "3";

        if ($peroid == 'month') {
            $interval = "1";
        } else if ($peroid == 'quarter') {
            $interval = "3";
        } else if ($peroid == 'year') {
            $interval = "12";
        }  



        $user = [];
        $account_manager = [];

        $q = 'SELECT * FROM crm3_user WHERE presence = 1 ' . $this->model->user_group()['query'];
        $q_user = $this->model->user_group('id_user')['query'];

        $query = $this->db->query($q);
        foreach ($query->result() as $row) {
            $temp = array(
                "id" => $row->id,
                "name" => $row->first_name . ' ' . $row->last_name,
            );
            array_push($user, $temp);
            array_push($account_manager, $temp);
        }

        $q_user_join = "";
        if ($id > 0) {
            $q_user = " and id_user = " . $id . " ";
            $q_user_join = " and l.id_user = " . $id . " ";

            $account_manager = array(
                array(
                    "id" => $id,
                    "name" => $this->model->crm3('concat(first_name," ",last_name)', 'user', 'id=' . $id),
                ),
            );
        }

      
        if(  date('m') == '1')  {  $curQuarter = 1;  } 
        if(  date('m') == '2')  {  $curQuarter = 1;  } 
        if(  date('m') == '3')  {  $curQuarter = 1;  } 

        if(  date('m') == '4')  {  $curQuarter = 2;  } 
        if(  date('m') == '5')  {  $curQuarter = 2;  } 
        if(  date('m') == '6')  {  $curQuarter = 2;  } 

        if(  date('m') == '7')  {  $curQuarter = 3;  } 
        if(  date('m') == '8')  {  $curQuarter = 3;  } 
        if(  date('m') == '9')  {  $curQuarter = 3;  } 

        if(  date('m') == '10')  {  $curQuarter = 4;  } 
        if(  date('m') == '11')  {  $curQuarter = 4;  } 
        if(  date('m') == '12')  {  $curQuarter = 4;  } 
        


        if(  $curQuarter == 1 ){ $beetwen = " ( input_date >= '".date('Y')."-01-01 00:00'   AND  input_date <= '".date('Y')."-03-31 23:59') "; } 
        else if(  $curQuarter == 2 ){ $beetwen = " ( input_date >= '".date('Y')."-04-01 00:00'   AND  input_date <= '".date('Y')."-06-30 23:59') "; } 
        else if(  $curQuarter == 3 ){ $beetwen = " ( input_date >= '".date('Y')."-07-01 00:00'   AND  input_date <= '".date('Y')."-09-30 23:59') "; } 
        else if(  $curQuarter == 4 ){ $beetwen = " ( input_date >= '".date('Y')."-10-01 00:00'   AND  input_date <= '".date('Y')."-12-31 23:59') "; } 

