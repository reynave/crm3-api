        FROM crm3_lead AS l
        LEFT JOIN crm3_lead_source AS ls ON ls.id = l.id_lead_source
        LEFT JOIN crm3_user AS u ON u.id = l.id_user
        WHERE  
        ".$interval."
        " . $q_user_join . " 
        ".$this->model->user_group('l.id_user')['query']."
        GROUP BY l.id_lead_source
        ";
