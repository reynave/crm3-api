            "today" => $this->model->crm3('COUNT(id)', 'lead',  "  DATE_FORMAT(input_date,'%y-%m-%d') = CURDATE() " . $q_user),
           // "month" => $this->model->crm3('COUNT(id)', 'lead', "  input_date  > CURDATE() - INTERVAL 30 DAY  " . $q_user),
             "month" => $this->model->crm3('COUNT(id)', 'lead', "   MONTH(input_date) =  MONTH(CURRENT_DATE())  " . $q_user),
           
            "quarter" => $this->model->crm3('COUNT(id)', 'lead',  $beetwen."  " . $q_user),
            "year" => $this->model->crm3('COUNT(id)', 'lead', "  YEAR(input_date) = '".date('Y')."' " . $q_user),
        );


        



        $year = " YEAR(input_date) = '".date('Y')."' ";
