                    "label" => "Quotes  remaining achievements",
                    "backgroundColor" => $backgroundColor[3][1],
                    "stack" => "quotes",
                    "data" => array(
                        $target[3]['q1']['target'] - $target[3]['q1']['achieve'] ,
                         $target[3]['q2']['target'] - $target[3]['q2']['achieve'] ,
                         $target[3]['q3']['target'] - $target[3]['q3']['achieve'] ,
                         $target[3]['q3']['target'] - $target[3]['q4']['achieve'] 
                    ),
                ),
            ),
        );

        $json = array(
            "error"  =>  0,
            "q" => $qls,
            "user_group" => $this->model->user_group()['query'],
            "result" => array(
                "currency" => $this->model->currency(),
                "lead" => $lead,
                "id_user_select" =>  $id ?  $id : "0",
                "account_manager" => $account_manager,
                "lead" => $lead,
                "funnel" => $funnel,
                "event" => $event,
                "visit" => $visit,
                "user" => $user,
                "leadPerDistribution" => $leadPerDistribution,
                "totalLS" => $totalLS,

                "leadPerIndustry" => $leadPerIndustry,
                "totalLI" => $totalLI,
 
                "target" => $target,

                "recentwins" => $recentwins,
                "recentQuotation" => $recentQuotation,
                "list" => $this->model->user_recursive($id),

                "barChartDataAmount" => $barChartDataAmount,
                "barChartDataQty" => $barChartDataQty,

            ),
        );

        echo json_encode($json);
    }


    
    public function home()
    {
        
        $q_user = " and id_user = " . $this->model->id_user() . " "; 
 

        $event = [];
        $query = $this->db->query('SELECT * FROM crm3_activity WHERE input_date  > CURDATE() - INTERVAL 1 MONTH and presence = 1 AND closed = 0 AND id_activity_type = 300 ' . $q_user);
        foreach ($query->result() as $row) {
            $temp = array(
                "id" => $row->id,
                "subject" => $row->subject,
                "name" => $row->id_module == '200' ?  $this->model->lead($row->id_person) :  $this->model->contact($row->id_person),
                "module" => $this->model->crm3('name', 'module', 'id=' . $row->id_module),
                "start_datetime" => $row->start_date . ' ' . $row->start_time,
            );
            array_push($event, $temp);
        }

        $visit = [];
        $query = $this->db->query('SELECT * FROM crm3_activity WHERE input_date  > CURDATE() - INTERVAL 1 MONTH AND   presence = 1 AND closed = 0 AND id_activity_type = 200 ' . $q_user);
        foreach ($query->result() as $row) {
            $temp = array(
                "id" => $row->id,
                "subject" => $row->subject,
                "name" => $row->id_module == '200' ?  $this->model->lead($row->id_person) :  $this->model->contact($row->id_person),
                "module" => $this->model->crm3('name', 'module', 'id=' . $row->id_module),
                "start_datetime" => $row->start_date . ' ' . $row->start_time,
            );
            array_push($visit, $temp);
        }

 
        $recentwins = [];
        $query = $this->db->query('SELECT * FROM crm3_sales_order WHERE presence = 1  ' . $q_user . '  order by update_date DESC limit 5');
        foreach ($query->result() as $row) {

            $temp = array(
                "id" => $row->id,
                "so_number" => $row->so_number,
                "company" => $this->model->crm3('name', 'company', 'id="' . $row->id_company . '" '),
                "grand_total" => $row->grand_total,
                // "status" => $this->model->crm3('name','quote_status','id="'.$row->id_quote_status.'" '),
                "input_date" => $row->input_date,
            );
            array_push($recentwins, $temp);
        }


        $recentQuotation = [];
        $query = $this->db->query('SELECT * FROM crm3_quote WHERE presence = 1 AND id_quote_status_final = 0  ' . $q_user . '  order by update_date DESC limit 5');
        foreach ($query->result() as $row) {
            $id_company =  $this->model->crm3('id_company', 'opportunity', 'id="' . $row->id_opportunity . '" ');
            $ver = $row->version > 0 ?  ' ver ' . $row->version : "";
            $temp = array(
                "id" => $row->id,
                "quotes_number" => $row->quotes_number . " " . $ver,
                "company" => $this->model->crm3('name', 'company', 'id="' . $id_company . '" '),
                "grand_total" => $row->grand_total,
                "status" => $this->model->crm3('name', 'quote_status', 'id="' . $row->id_quote_status . '" '),
                "input_date" => $row->input_date,
            );
            array_push($recentQuotation, $temp);
        }

 
        
        $json = array(
            "error"  =>  0,
            "id_user" => $this->model->id_user(),
            "result" => array(
                "currency" => $this->model->currency(),
                "user" => array(
                    "name" => $this->model->crm3("concat(first_name,' ',last_name)","user","id = ".$this->model->id_user() ),
                    "company" => $this->model->select("company","account","id = 1" ), 
                ),
                "event" => $event,
                "visit" => $visit,
                "recentwins" => $recentwins,
                "recentQuotation" => $recentQuotation,
            ),
        );

        echo json_encode($json);
    }
}
